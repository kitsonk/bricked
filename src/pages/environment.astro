---
import Shell from "../layouts/Shell.astro";
import Frame from "../layouts/Frame.astro";

// Read directly from the environment: this page is server-rendered only, so the values
// are never shipped to the client.
const isSet = (name: string) => Deno.env.get(name) ? "set" : "missing";
const badge = (name: string) => `badge badge-sm mr-2 ${Deno.env.get(name) ? "badge-success" : "badge-warning"}`;
---
<Shell>
  <Frame>
    <div class="max-w-lg">
      <h1 class="text-2xl font-bold mb-6">Environment</h1>

      <div class="card bg-base-200">
        <div class="card-body">
          <h2 class="card-title text-lg">BrickLink API Credentials</h2>
          <p class="text-sm text-base-content/60 mb-4">
            Credentials are configured via environment variables. Set the following in your <code>.env</code>{" "}
            file (local) or application configuration (Deno Deploy):
          </p>
          <ul class="text-sm font-mono space-y-1">
            <li><span class={badge("BRICKLINK_CONSUMER_KEY")}>{isSet("BRICKLINK_CONSUMER_KEY")}</span> BRICKLINK_CONSUMER_KEY</li>
            <li><span class={badge("BRICKLINK_CONSUMER_SECRET")}>{isSet("BRICKLINK_CONSUMER_SECRET")}</span> BRICKLINK_CONSUMER_SECRET</li>
            <li><span class={badge("BRICKLINK_TOKEN")}>{isSet("BRICKLINK_TOKEN")}</span> BRICKLINK_TOKEN</li>
            <li><span class={badge("BRICKLINK_TOKEN_SECRET")}>{isSet("BRICKLINK_TOKEN_SECRET")}</span> BRICKLINK_TOKEN_SECRET</li>
          </ul>
          <p class="text-sm text-base-content/60 mt-4">
            Create an API key in your{" "}
            <a
              class="link"
              href="https://www.bricklink.com/v3/api.page"
              target="_blank"
              rel="noopener noreferrer"
            >
              BrickLink API settings
            </a>.
          </p>
        </div>
      </div>

      <div class="card bg-base-200 mt-6">
        <div class="card-body">
          <h2 class="card-title text-lg">AddressFinder Credentials</h2>
          <p class="text-sm text-base-content/60 mb-4">
            Used to verify and normalise Australian shipping addresses. Set the following in your <code>.env</code>{" "}
            file (local) or application configuration (Deno Deploy):
          </p>
          <ul class="text-sm font-mono space-y-1">
            <li><span class={badge("ADDRESSFINDER_KEY")}>{isSet("ADDRESSFINDER_KEY")}</span> ADDRESSFINDER_KEY</li>
            <li><span class={badge("ADDRESSFINDER_SECRET")}>{isSet("ADDRESSFINDER_SECRET")}</span> ADDRESSFINDER_SECRET</li>
          </ul>
        </div>
      </div>

      <div class="card bg-base-200 mt-6">
        <div class="card-body">
          <h2 class="card-title text-lg">Sender Address</h2>
          <p class="text-sm text-base-content/60 mb-4">
            Sender address is configured via the <a href="/configuration" class="link">Configuration</a>{" "}
            page and stored in Deno KV.
          </p>
        </div>
      </div>

      <div class="card bg-base-200 mt-6">
        <div class="card-body">
          <h2 class="card-title text-lg">Application Auth</h2>
          <p class="text-sm text-base-content/60 mb-4">
            Basic auth credentials gate the entire app (except static assets and the BrickLink notification webhook).
            When unset, authentication is disabled and a warning is logged at startup.
          </p>
          <ul class="text-sm font-mono space-y-1">
            <li><span class={badge("APP_USERNAME")}>{isSet("APP_USERNAME")}</span> APP_USERNAME</li>
            <li><span class={badge("APP_PASSWORD")}>{isSet("APP_PASSWORD")}</span> APP_PASSWORD</li>
            <li><span class={badge("SESSION_SECRET")}>{isSet("SESSION_SECRET")}</span> SESSION_SECRET</li>
          </ul>
        </div>
      </div>
    </div>
  </Frame>
</Shell>
