---
import Shell from "../../layouts/Shell.astro";
import Frame from "../../layouts/Frame.astro";
import DriveThruTemplates from "@/islands/DriveThruTemplates.tsx";
import { loadDriveThruTemplates } from "@/routes/drive-thru/templates.ts";

const result = await loadDriveThruTemplates();
if (result.kind !== "data") {
  if (result.kind === "redirect") return Astro.redirect(result.to);
  if (result.kind === "notFound") return new Response("Not found", { status: 404 });
  return result.response;
}
const { templates } = result.data;
---
<Shell>
  <Frame>
    <div class="max-w-2xl">
      <div class="mb-6">
        <h1 class="text-2xl font-bold">Drive Thru Templates</h1>
        <p class="text-sm text-base-content/60 mt-1">
          Templates are used to preview the message that will be sent to buyers via BrickLink's Drive Thru feature.
        </p>
      </div>
      <DriveThruTemplates initialTemplates={templates} client:load />
    </div>
  </Frame>
</Shell>
