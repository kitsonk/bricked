---
import Shell from "../layouts/Shell.astro";
import Frame from "../layouts/Frame.astro";
import PackageTypes from "@/islands/PackageTypes.tsx";
import { loadPackageTypes } from "@/routes/package-types.ts";

const result = await loadPackageTypes();
if (result.kind !== "data") {
  if (result.kind === "redirect") return Astro.redirect(result.to);
  if (result.kind === "notFound") return new Response("Not found", { status: 404 });
  return result.response;
}
const { packageTypes } = result.data;
---
<Shell>
  <Frame>
    <h1 class="text-2xl font-bold mb-6">Package Types</h1>
    <PackageTypes initialItems={packageTypes} client:load />
  </Frame>
</Shell>
