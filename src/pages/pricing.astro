---
import Shell from "../layouts/Shell.astro";
import Frame from "../layouts/Frame.astro";
import PricingAnalysis from "@/islands/PricingAnalysis.tsx";
import { loadPricing } from "@/routes/pricing.ts";

const result = await loadPricing();
if (result.kind !== "data") {
  if (result.kind === "redirect") return Astro.redirect(result.to);
  if (result.kind === "notFound") return new Response("Not found", { status: 404 });
  return result.response;
}
const { settings } = result.data;
---
<Shell>
  <Frame>
    <h1 class="text-2xl font-bold mb-6">Pricing Analysis</h1>
    <PricingAnalysis initialSettings={settings} client:load />
  </Frame>
</Shell>
