{
  "nodeModulesDir": "manual",
  "unstable": ["kv", "cron", "fmt-component"],
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check astro.config.ts routes/ islands/ components/ utils/ middleware/ src/ src/serve.ts",
    "test": "deno test --allow-env utils/ routes/",
    "test:smoke": "deno test --allow-all tests/",
    "dev": "deno run -A --env-file npm:astro dev",
    "build": "deno run -A --env-file npm:astro build",
    "start": "deno run -A --env-file src/serve.ts"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": ["**/*.svg"]
  },
  "exclude": [
    "**/dist/*",
    "**/.astro/*"
  ],
  "imports": {
    "@/": "./",
    "@astrojs/preact": "npm:@astrojs/preact@^6.0.5",
    "@blaze/human-readable-timestamp": "jsr:@blaze/human-readable-timestamp@^1.0.0",
    "@deno/astro-adapter": "npm:@deno/astro-adapter@^0.6.0",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
    "@iconify-json/lucide": "npm:@iconify-json/lucide@^1.2.129",
    "@iconify/tailwind4": "npm:@iconify/tailwind4@^1.2.3",
    "@jsr/deno__loader": "npm:@jsr/deno__loader@^0.5.0",
    "@kitsonk/logtape-kv-sink": "jsr:@kitsonk/logtape-kv-sink@^0.2.1",
    "@libs/xml": "jsr:@libs/xml@^8",
    "@logtape/logtape": "jsr:@logtape/logtape@^2.3.3",
    "@preact/signals": "npm:@preact/signals@^2.11.2",
    "@std/csv": "jsr:@std/csv@^1.0.6",
    "@std/http": "jsr:@std/http@^1.1.1",
    "@std/path": "jsr:@std/path@^1.1.6",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/node": "npm:@types/node@^26.6.3",
    "astro": "npm:astro@^7.3.5",
    "daisyui": "npm:daisyui@^5.5.28",
    "preact": "npm:preact@^10.19.8",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "tailwindcss-motion": "npm:tailwindcss-motion@^1.1.1",
    "vite": "npm:vite@^7.3.5"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns", "deno.unstable"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": ["vite/client"]
  }
}
